component coss
% Nonlinear device capacitance (textbook E02): i = C(v) dv/dt,
% C(v) = C0/sqrt(1 + v/V0) for v >= 0 (C0 below 0 V, outside the model).
% No initial target: the voltage follows from the circuit.
  nodes
    p = foundation.electrical.electrical; % +:left
    n = foundation.electrical.electrical; % -:right
  end
  parameters
    C0 = {2e-9, 'F'};    % Capacitance at 0 V
    V0 = {40, 'V'};      % Knee voltage
  end
  variables
    i = {0, 'A'};        % Current
    v = {0, 'V'};        % Voltage
  end
  branches
    i : p.i -> n.i;
  end
  equations
    v == p.v - n.v;
    if v > 0
      i == C0/sqrt(1 + v/V0)*v.der;
    else
      i == C0*v.der;
    end
  end
end
