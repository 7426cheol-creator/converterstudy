component vdc
% Ideal DC voltage source, v(p) - v(n) = V.
  nodes
    p = foundation.electrical.electrical; % +:left
    n = foundation.electrical.electrical; % -:right
  end
  parameters
    V = {800, 'V'};      % Voltage
  end
  variables
    i = {0, 'A'};        % Current from p to n through the source
    v = {0, 'V'};        % Voltage
  end
  branches
    i : p.i -> n.i;
  end
  equations
    v == p.v - n.v;
    v == V;
  end
end
